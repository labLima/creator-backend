APP_ENV=local
APP_NAME=creator-api
LOG_LEVEL=INFO
# DATABASE_URL=sqlite+pysqlite:///./.local/db/creator.db
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=1
RATE_LIMIT_KEY_PREFIX=creator:rate-limit:v1
AUTH_REQUIRED=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=creator
AUTH_JWT_AUDIENCE=creator-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_COOKIE_SESSIONS_ENABLED=true
AUTH_LEGACY_BEARER_ENABLED=true
AUTH_TOKEN_BODY_ENABLED=true
AUTH_COOKIE_ACCESS_NAME=creator_access
AUTH_COOKIE_REFRESH_NAME=creator_refresh
AUTH_COOKIE_CSRF_NAME=creator_csrf
AUTH_COOKIE_ACCESS_PATH=/api/v1
AUTH_COOKIE_REFRESH_PATH=/api/v1/auth
AUTH_COOKIE_CSRF_PATH=/
# Access is Lax; refresh is Strict for same-site deployments. Use none only
# with HTTPS and an explicit cross-site CORS allowlist.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_CSRF_TTL_SECONDS=900
AUTH_REFRESH_ROTATION_GRACE_SECONDS=30
AUTH_SESSION_ABSOLUTE_TTL_DAYS=90
AUTH_SESSION_RETENTION_DAYS=30
AUTH_CORS_ORIGINS=[]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=5
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TIMEOUT_SECONDS=30
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=8
CREWAI_ENABLED=false
LANGCHAIN_ENABLED=false
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_VECTOR_STORE_PROVIDER=chroma
RAG_VECTOR_STORE_PATH=.local/rag/chroma
RAG_COLLECTION_NAME=creator-content
RAG_TOP_K=5
GENERATION_QUEUE_NAME=creator:rq:generations
IMAGE_GENERATION_JOB_TIMEOUT_SECONDS=300
IMAGE_GENERATION_JOB_MAX_ATTEMPTS=3
IMAGE_GENERATION_RETRY_INTERVAL_SECONDS=[60,120,240]
IMAGE_GENERATION_STALE_PROCESSING_SECONDS=900
AGENT_WORKFLOW_MAX_REFINEMENTS=3
AGENT_WORKFLOW_JOB_TIMEOUT_SECONDS=900
AGENT_REVIEWER_MODEL=gemini-2.5-flash
STORAGE_PROVIDER=local
STORAGE_BUCKET=creator-images
STORAGE_MAX_OBJECT_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600
# LOCAL_STORAGE_ROOT=.local/storage
